ARG DISTROLESS_SHA="pass-a-valid-docker-sha-otherwise-this-will-fail"

FROM gcr.io/distroless/base@sha256:${DISTROLESS_SHA}
LABEL maintainer="FuseOne"
LABEL io.modelcontextprotocol.server.name="io.github.fuseone-io/fusescope-mcp-server"
WORKDIR /usr/local/fusescope-mcp-server

ARG OS="linux"
ARG ARCH

COPY ./target/${OS}-${ARCH}/fusescope-mcp-server /usr/local/bin/fusescope-mcp-server

ENTRYPOINT ["/usr/local/bin/fusescope-mcp-server"]
